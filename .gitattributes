*.sh text eol=lf
# The published OTA bootstrap records the exact public-key PEM fingerprint.
packaging/software/trusted-release-key.pem text eol=lf
# Linux executes integration helpers directly through their shebang.
packaging/integrations/*.py text eol=lf
# Preserve the owner's original PS2 research CSV attachments byte-for-byte.
docs/data/ps2/*.csv -text whitespace=cr-at-eol
*.ttf binary
# Software source archives do not distribute standalone avatar model geometry.
# Originals stay in Git; runtime asset packaging is reviewed independently.
assets/avatar/**/*.blend export-ignore
assets/avatar/**/*.blend1 export-ignore
assets/avatar/**/*.fbx export-ignore
assets/avatar/**/*.glb export-ignore
assets/avatar/**/*.gltf export-ignore
assets/avatar/**/*.obj export-ignore
assets/avatar/**/*.bin export-ignore
# Preserve byte identities of retained release manifests and source inventories.
docs/evidence/2026-11-03-release-delivery/*.json text eol=lf
docs/evidence/2026-11-03-release-delivery/*.log text eol=lf
# Peer recipes hash the raw runtime manifest on Windows and Linux alike.
assets/avatar/packs/*/manifest.json text eol=lf
# Preserve hashed approved eye assets and their evidence byte-for-byte.
assets/avatar/approved/2026-10-26/chibi-eyes/* -text whitespace=cr-at-eol
assets/avatar/approved/base-body/* -text whitespace=cr-at-eol
# Unified diff context prefixes can precede upstream tabs and blank lines.
*.patch text eol=lf whitespace=-blank-at-eol,-space-before-tab
# Preserve the final blank context line in the PPSSPP coordination patch.
tools/ppsspp-relay/coordination-stream.patch whitespace=-blank-at-eol,-space-before-tab,-blank-at-eof
# Keep the upstream git-format-patch export byte-for-byte, including its final blank line.
packaging/kernel/iris/0001-upstream-request-keyframe.patch whitespace=-blank-at-eol,-space-before-tab,-blank-at-eof
# Preserve the reused patch's trailing context and the upstream license text.
tools/gamescope-capture/0001-pipewire-buffer-association.patch whitespace=-blank-at-eol,-space-before-tab,-blank-at-eof
tools/gamescope-capture/LICENSE.gamescope text eol=lf whitespace=-blank-at-eof
# Preserve downloaded dependency notices, including the MPL text's upstream space.
tools/remote-play-stream/transport/licenses/* -text
tools/remote-play-stream/transport/licenses/lib*.LICENSE whitespace=-blank-at-eol
# These notices are hashed in the Crates artwork provenance; preserve upstream bytes.
assets/crates/examples/*-LICENSE.txt -text whitespace=-blank-at-eof
# Preserve the collected upstream Mesa GLU notice comment formatting.
packaging/emulators/supermodel/GLU-NOTICES.txt text eol=lf whitespace=-blank-at-eol
docs/adapters/implementations/runtime/packaging/emulators/supermodel/GLU-NOTICES.txt text eol=lf whitespace=-blank-at-eol

# Preserve the exact upstream Odamex third-party notices.
packaging/emulators/odamex/3RD-PARTY-LICENSES text eol=lf whitespace=-blank-at-eol
docs/adapters/implementations/runtime/packaging/emulators/odamex/3RD-PARTY-LICENSES text eol=lf whitespace=-blank-at-eol
