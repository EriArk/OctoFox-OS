+GameType CSimNetBoard::LinkType(const Game& game)
+{
+	const auto IsGame = [&game](const char* name){ return game.name == name || game.parent == name; };
+	if (IsGame("daytona2") || IsGame("harley") || IsGame("scud") || IsGame("srally2") ||
+		IsGame("skichamp") || IsGame("spikeout") || IsGame("spikeofe"))
+		return GameType::one;
+	else if (IsGame("lemans24") || IsGame("von2") || IsGame("dirtdvls"))
+		return GameType::two;
+	else
+		return GameType::unknown;
+
+}
