config_version=5
[application]
config/name="OctoFox · Ship Home"
config/use_custom_user_dir=true
config/custom_user_dir_name="octofox-ship-home"
run/main_scene="res://transit.tscn"
boot_splash/fullsize=true
boot_splash/image="res://assets/transit/transit-boot.png"
boot_splash/bg_color=Color(0.035,0.047,0.09,1)
[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1

[input]
ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194309), Object(InputEventKey,"keycode":4194310), Object(InputEventKey,"keycode":32), Object(InputEventJoypadButton,"device":-1,"button_index":1)]
}
ui_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194305), Object(InputEventJoypadButton,"device":-1,"button_index":0)]
}
